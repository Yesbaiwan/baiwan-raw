#!name=番茄小说去广告(路径级)
#!desc=按 URL 路径拦掉落在共享 CDN 上的番茄广告(域名级规则拦不到的那部分)
#!author=Yesbaiwan
#!homepage=https://github.com/Yesbaiwan/baiwan-raw
#!icon=https://cdn.jsdelivr.net/gh/Yesbaiwan/baiwan-raw@main/dawo.jpg
#
# 取舍
#   pglstatp-toutiao 路径规则已删: 该域在域名层整段 REJECT 且未进 MITM, 写了也永远不触发。
#   snssdk 的 /api/ad/、video/play/toutiao: 上游写了却没 MITM *.snssdk.com, 实际不生效;
#     要生效得解密整个 snssdk, 会波及正常阅读域, 不划算。
#   byteimg 广告图桶 tos-cn-i-1yzifmftcy: 需 MITM 整个 *.byteimg.com, 开销大且可能坏图, 不做。
#
# 来源
#   https://github.com/deezertidal/shadowrocket-rules  -> modules/fanqie.module
#   https://github.com/honue/rules                     -> Loon/plugin/FanQieNovel.plugin
#   https://github.com/numiame/RULE-SET                -> fqnovel.module(短剧主机名写法参考)

[URL Rewrite]
# 章末 / 插屏广告素材
^https?:\/\/.+\.pstatp\.com\/(?:(?:obj|img)\/)?(?:ad-app-package|ad)\/.+ - reject
^https?:\/\/.+\.pstatp\.com\/(?:obj|img)\/web\.business\.image\/.+ - reject
^https?:\/\/.+\.pstatp\.com\/obj\/ad-pattern\/renderer - reject
^https?:\/\/.+\.pstatp\.com\/obj\/ad-site-adstyle-public\/.+ - reject
# 埋点上报与版本包
^https?:\/\/gurd\.snssdk\.com\/src\/server\/v3\/package - reject
^https?:\/\/.+\.pstatp\.com\/bytecom\/resource\/track[-_]log\/src\/.+ - reject
^https?:\/\/.+\.pstatp\.com\/obj\/mosaic-legacy\/.+\?from\=ad - reject
# 短剧视频广告(主机名可能带 -se-gddgtc 之类中缀, 故不限定 v\d+)
^https?:\/\/[^\/]+-novelapp\.fqnovelvod\.com\/.+\/video\/.+ - reject
# 内嵌拼多多联盟广告
^https?:\/\/adim\.pinduoduo\.com\/.+\/toutiao\?.+ - reject
# byteimg 广告路径(仅明文 HTTP 命中, 不需要解密)
^http:\/\/.+\.byteimg\.com\/ad-app-package - reject
^http:\/\/.+\.byteimg\.com\/web\.business\.image - reject

[MITM]
hostname = %APPEND% *.pstatp.com, gurd.snssdk.com, *novelapp.fqnovelvod.com, adim.pinduoduo.com
